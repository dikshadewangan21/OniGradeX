# Copy to backend/.env. Never commit the real file.
DATABASE_URL=postgresql+psycopg://onigrader:CHANGE_ME@db:5432/onigrader
JWT_SECRET=            # required: openssl rand -hex 32
CERTIFICATE_SIGNING_KEY=  # required: openssl rand -hex 32 (rotating it invalidates verification of old certificates)
MODEL_METADATA_PATH=/app/ml/artifacts/model_metadata.json
MODEL_FILE_PATH=/app/ml/artifacts/onion_model.tflite
UPLOAD_DIR=/data/uploads
ENAM_API_URL=          # your e-NAM/Agmarknet adapter endpoint; leave empty to disable (503, never fake prices)
ENAM_API_KEY=
RATE_LIMIT=60/minute
CORS_ORIGINS=
POSTGRES_PASSWORD=CHANGE_ME
